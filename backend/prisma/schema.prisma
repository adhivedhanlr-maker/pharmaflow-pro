generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DEVELOPER
  BILLING_OPERATOR
  WAREHOUSE_MANAGER
  SALES_REP
  ACCOUNTANT
}

enum PaymentMethod {
  HOURLY
  SALARY
}

model User {
  id               String          @id @default(cuid())
  username         String
  password         String
  name             String
  role             Role            @default(BILLING_OPERATOR)
  tenantId         String?
  tenant           TenantBranding? @relation(fields: [tenantId], references: [id])
  canGenerateInvoice Boolean       @default(false)
  permissions      String[]        @default([])
  isOnDuty         Boolean         @default(false)
  twoFactorEnabled Boolean         @default(false)
  twoFactorSecret  String?
  lastLat          Float?
  lastLng          Float?
  paymentMethod    PaymentMethod   @default(HOURLY)
  monthlySalary    Float           @default(0)
  hourlyRate       Float           @default(500)
  overtimeRate     Float           @default(750)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  Sales            Sale[]          @relation("SaleUser")
  RepSales         Sale[]          @relation("SaleRep")
  visits           Visit[]
  orders           Order[]
  attendance       Attendance[]
  routes           Route[]
  locationLogs     LocationLog[]
  businessProfile      BusinessProfile?
  pushSubscriptions    PushSubscription[]
  webAuthnCredentials  WebAuthnCredential[]

  @@unique([tenantId, username])
  @@index([tenantId])
}

model RolePermission {
  id          String   @id @default(cuid())
  tenantId    String
  role        String
  permissions String[]
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, role])
  @@index([tenantId])
}

model Attendance {
  id        String          @id @default(cuid())
  userId    String
  tenantId  String?
  user      User            @relation(fields: [userId], references: [id])
  tenant    TenantBranding? @relation(fields: [tenantId], references: [id])
  date      DateTime        @default(now())
  startTime DateTime        @default(now())
  endTime   DateTime?
  duration  Float?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
}

model Product {
  id            String          @id @default(cuid())
  name          String
  tenantId      String?
  tenant        TenantBranding? @relation(fields: [tenantId], references: [id])
  hsnCode       String?
  gstRate       Float           @default(0)
  mrp           Float
  company       String?
  composition   String?
  packing       String?
  reorderLevel  Int             @default(10)
  barcode       String?
  barcodeType   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  batches       Batch[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  orderItems    OrderItem[]

  @@index([tenantId])
  @@index([name])
  @@index([company])
  @@index([barcode])
}

model Batch {
  id            String          @id @default(cuid())
  batchNumber   String
  tenantId      String?
  tenant        TenantBranding? @relation(fields: [tenantId], references: [id])
  batchBarcode  String?
  expiryDate    DateTime
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  currentStock  Int             @default(0)
  mrp           Float?
  purchasePrice Float
  salePrice     Float
  ptr           Float?
  pts           Float?
  nr            Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([productId, batchNumber, supplierId])
  @@index([tenantId])
  @@index([currentStock])
  @@index([expiryDate])
  @@index([batchBarcode])
}

model Customer {
  id             String          @id @default(cuid())
  name           String
  tenantId       String?
  tenant         TenantBranding? @relation(fields: [tenantId], references: [id])
  gstin          String?
  address        String?
  phone          String?
  landPhone      String?
  email          String?
  state          String?
  dlNo           String?
  fssaiNo        String?
  latitude       Float?
  longitude      Float?
  creditLimit    Float           @default(0)
  currentBalance Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  visits         Visit[]
  orders         Order[]
  routeStops     RouteStop[]

  @@index([tenantId])
  @@index([name])
  @@index([phone])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  tenantId       String?
  tenant         TenantBranding? @relation(fields: [tenantId], references: [id])
  gstin          String?
  address        String?
  phone          String?
  landPhone      String?
  latitude       Float?
  longitude      Float?
  currentBalance Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchases      Purchase[]
  batches        Batch[]

  @@index([tenantId])
  @@index([name])
  @@index([phone])
}

model Sale {
  id             String            @id @default(cuid())
  invoiceNumber  String            @unique
  tenantId       String?
  tenant         TenantBranding?   @relation(fields: [tenantId], references: [id])
  date           DateTime          @default(now())
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id])
  userId         String?
  user           User?             @relation("SaleUser", fields: [userId], references: [id])
  repId          String?
  rep            User?             @relation("SaleRep", fields: [repId], references: [id])
  totalAmount    Float
  gstAmount      Float
  netAmount      Float
  discountAmount Float             @default(0)
  isCash         Boolean           @default(true)
  paymentMethod  SalePaymentMethod @default(CASH)
  customerType   String?           @default("PHARMACY")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          SaleItem[]
  returns        SaleReturn[]
  deliveryStatus DeliveryStatus    @default(PENDING)
  deliveryOtp    String?
  deliveredAt    DateTime?
  deliveryProof  DeliveryProof?

  @@index([tenantId])
}

enum SalePaymentMethod {
  CASH
  CREDIT
  UPI
  CARD
  BANK_TRANSFER
}

model DeliveryProof {
  id           String          @id @default(cuid())
  saleId       String          @unique
  tenantId     String?
  tenant       TenantBranding? @relation(fields: [tenantId], references: [id])
  sale         Sale            @relation(fields: [saleId], references: [id])
  proofUrl     String?
  signatureUrl String?
  latitude     Float?
  longitude    Float?
  info         String?
  createdAt    DateTime        @default(now())

  @@index([tenantId])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  RETURNED
}

model SaleItem {
  id          String          @id @default(cuid())
  saleId      String
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  sale        Sale            @relation(fields: [saleId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  batchId     String
  batch       Batch           @relation(fields: [batchId], references: [id])
  quantity     Int
  freeQuantity Int    @default(0)
  unitPrice    Float
  gstRate      Float
  gstAmount    Float
  totalAmount  Float
  returns      SaleReturnItem[]

  @@index([tenantId])
}

model Purchase {
  id          String          @id @default(cuid())
  billNumber  String
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  date        DateTime        @default(now())
  invoiceDate DateTime?
  dueDate     DateTime?
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  totalAmount Float
  gstAmount   Float
  roundOff    Float           @default(0)
  netAmount   Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PurchaseItem[]
  returns     PurchaseReturn[]

  @@index([tenantId])
}

model PurchaseItem {
  id            String          @id @default(cuid())
  purchaseId    String
  tenantId      String?
  tenant        TenantBranding? @relation(fields: [tenantId], references: [id])
  purchase      Purchase        @relation(fields: [purchaseId], references: [id])
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  batchId       String
  batch         Batch           @relation(fields: [batchId], references: [id])
  quantity      Int
  freeQty       Int     @default(0)
  discountPct   Float   @default(0)
  purchasePrice Float
  gstRate       Float
  gstAmount     Float
  totalAmount   Float
  returns       PurchaseReturnItem[]

  @@index([tenantId])
}

model SaleReturn {
  id          String          @id @default(cuid())
  saleId      String
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  sale        Sale            @relation(fields: [saleId], references: [id])
  date        DateTime        @default(now())
  totalAmount Float
  items       SaleReturnItem[]

  @@index([tenantId])
}

model SaleReturnItem {
  id           String          @id @default(cuid())
  saleReturnId String
  tenantId     String?
  tenant       TenantBranding? @relation(fields: [tenantId], references: [id])
  saleReturn   SaleReturn      @relation(fields: [saleReturnId], references: [id])
  saleItemId   String
  saleItem     SaleItem        @relation(fields: [saleItemId], references: [id])
  quantity     Int
  reason       String?

  @@index([tenantId])
}

model PurchaseReturn {
  id          String          @id @default(cuid())
  purchaseId  String
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  purchase    Purchase        @relation(fields: [purchaseId], references: [id])
  date        DateTime        @default(now())
  totalAmount Float
  items       PurchaseReturnItem[]

  @@index([tenantId])
}

model PurchaseReturnItem {
  id               String          @id @default(cuid())
  purchaseReturnId String
  tenantId         String?
  tenant           TenantBranding? @relation(fields: [tenantId], references: [id])
  purchaseReturn   PurchaseReturn  @relation(fields: [purchaseReturnId], references: [id])
  purchaseItemId   String
  purchaseItem     PurchaseItem    @relation(fields: [purchaseItemId], references: [id])
  quantity         Int
  reason           String?

  @@index([tenantId])
}

model Notification {
  id        String          @id @default(cuid())
  type      String
  message   String
  tenantId  String?
  tenant    TenantBranding? @relation(fields: [tenantId], references: [id])
  isRead    Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([tenantId])
}

model BusinessProfile {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id])
  userId      String          @unique
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  companyName   String
  gstin         String?
  email         String?
  phone         String?
  address       String?
  logoUrl       String?
  panNo         String?
  dlNo          String?
  fssaiNo       String?
  bankName      String?
  bankBranch    String?
  bankAccountNo String?
  bankIfsc      String?
  paymentQrUrl  String?
  showLogo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tenantId])
}

model AuditLog {
  id        String          @id @default(cuid())
  userId    String
  tenantId  String?
  tenant    TenantBranding? @relation(fields: [tenantId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime        @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Visit {
  id          String          @id @default(cuid())
  repId       String
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  rep         User            @relation(fields: [repId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  checkInTime DateTime        @default(now())
  latitude    Float
  longitude   Float
  distance    Float?
  status      String
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([repId])
  @@index([customerId])
  @@index([createdAt])
}

model Order {
  id          String          @id @default(cuid())
  orderNumber String          @unique
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  repId       String
  rep         User            @relation(fields: [repId], references: [id])
  status      OrderStatus     @default(PENDING)
  totalAmount Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       OrderItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([repId])
  @@index([status])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  tenantId    String?
  tenant      TenantBranding? @relation(fields: [tenantId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id])
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  quantity    Int
  price       Float
  isBackorder Boolean         @default(false)

  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  CANCELLED
}

model Route {
  id        String          @id @default(cuid())
  repId     String
  tenantId  String?
  tenant    TenantBranding? @relation(fields: [tenantId], references: [id])
  rep       User            @relation(fields: [repId], references: [id])
  date      DateTime
  status    RouteStatus     @default(DRAFT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  stops     RouteStop[]

  @@unique([repId, date])
  @@index([tenantId])
  @@index([repId])
  @@index([date])
}

model RouteStop {
  id         String          @id @default(cuid())
  routeId    String
  tenantId   String?
  tenant     TenantBranding? @relation(fields: [tenantId], references: [id])
  route      Route           @relation(fields: [routeId], references: [id])
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  stopOrder  Int
  status     StopStatus      @default(PENDING)
  notes      String?
  visitedAt  DateTime?

  @@index([tenantId])
  @@index([routeId])
  @@index([customerId])
}

enum RouteStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum StopStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model LocationLog {
  id        String          @id @default(cuid())
  userId    String
  tenantId  String?
  tenant    TenantBranding? @relation(fields: [tenantId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  latitude  Float
  longitude Float
  timestamp DateTime        @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
}

model TenantBranding {
  id                  String              @id @default(cuid())
  slug                String              @unique
  companyName         String
  customDomain        String?             @unique
  logoUrl             String?
  primaryColor        String?             @default("#2563eb")
  accentColor         String?             @default("#0f172a")
  loginTitle          String?
  loginSubtitle       String?
  faviconUrl          String?
  isDefault           Boolean             @default(false)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  users               User[]
  attendances         Attendance[]
  products            Product[]
  batches             Batch[]
  customers           Customer[]
  suppliers           Supplier[]
  sales               Sale[]
  deliveryProofs      DeliveryProof[]
  saleItems           SaleItem[]
  purchases           Purchase[]
  purchaseItems       PurchaseItem[]
  saleReturns         SaleReturn[]
  saleReturnItems     SaleReturnItem[]
  purchaseReturns     PurchaseReturn[]
  purchaseReturnItems PurchaseReturnItem[]
  notifications       Notification[]
  businessProfiles    BusinessProfile[]
  auditLogs           AuditLog[]
  visits              Visit[]
  orders              Order[]
  orderItems          OrderItem[]
  routes              Route[]
  routeStops          RouteStop[]
  locationLogs        LocationLog[]
  pushSubscriptions   PushSubscription[]

  @@index([slug])
  @@index([customDomain])
  @@index([isActive])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String?
  credentialId String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

model InvoiceSequence {
  id            String   @id @default(cuid())
  tenantId      String
  financialYear String
  lastNumber    Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, financialYear])
  @@index([tenantId])
}

model PushSubscription {
  id        String          @id @default(cuid())
  endpoint  String          @unique
  p256dh    String
  auth      String
  userId    String
  tenantId  String?
  user      User            @relation(fields: [userId], references: [id])
  tenant    TenantBranding? @relation(fields: [tenantId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, endpoint])
  @@index([tenantId])
  @@index([userId])
}
